{
  "name": "vhash-vscode-ext-v2",
  "displayName": "vHash Copy Path",
  "version": "0.0.17",
  "publisher": "vHash",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaohuqiu/vhash-vscode-ext"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vhashTools.copySelectionPathRange",
    "onCommand:vhashTools.copyPathRelativeToHome",
    "onCommand:vhashTools.copyFileOrDirectoryName",
    "onCommand:vhashTools.configureVimKeybindings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vhashTools.copySelectionPathRange",
        "title": "vHash: Copy Path With Line Range"
      },
      {
        "command": "vhashTools.copyPathRelativeToHome",
        "title": "vHash: Copy Path Relative to Home"
      },
      {
        "command": "vhashTools.copyFileOrDirectoryName",
        "title": "vHash: Copy File or Directory Name"
      },
      {
        "command": "vhashTools.configureVimKeybindings",
        "title": "vHash: Configure Vim Keybindings"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.action.showCommands",
        "key": "shift+alt+p",
        "mac": "shift+cmd+p"
      },
      {
        "command": "workbench.files.action.showActiveFileInExplorer",
        "key": "shift+alt+e",
        "mac": "shift+cmd+e"
      },
      {
        "command": "workbench.action.findInFiles",
        "key": "shift+alt+f",
        "mac": "shift+cmd+f"
      },
      {
        "command": "workbench.action.quickOpen",
        "key": "shift+alt+o",
        "mac": "shift+cmd+o"
      },
      {
        "command": "workbench.action.previousEditor",
        "key": "shift+alt+[",
        "mac": "shift+cmd+["
      },
      {
        "command": "workbench.action.nextEditor",
        "key": "shift+alt+]",
        "mac": "shift+cmd+]"
      },
      {
        "command": "vhashTools.copySelectionPathRange",
        "key": "shift+alt+c",
        "mac": "shift+cmd+c",
        "when": "editorTextFocus"
      },
      {
        "command": "copyFilePath",
        "key": "shift+alt+c",
        "mac": "shift+cmd+c",
        "when": "!editorFocus"
      },
      {
        "command": "vhashTools.copySelectionPathRange",
        "key": "ctrl+k n",
        "mac": "cmd+k n",
        "when": "editorTextFocus"
      },
      {
        "command": "vhashTools.copyPathRelativeToHome",
        "key": "ctrl+k h",
        "mac": "cmd+k h",
        "when": "editorTextFocus"
      },
      {
        "command": "vhashTools.copyFileOrDirectoryName",
        "key": "ctrl+k f",
        "mac": "cmd+k f",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vhashTools.copyPathRelativeToHome",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        },
        {
          "command": "vhashTools.copyFileOrDirectoryName",
          "when": "resourceScheme == file",
          "group": "navigation@91"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
